{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vitest/globals", "./worker-configuration.d.ts"]
  },
  "include": [
    "shared/**/*.test.ts",
    "worker/**/*.test.ts",
    "tests/**/*.test.ts",
    "worker/test/env.d.ts",
    "worker/env.d.ts"
  ]
}
