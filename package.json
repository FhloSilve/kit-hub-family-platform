{
  "name": "kit-hub-family-platform",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:ui": "vite --config vite.ui.config.ts --open '/?demo=1'",
    "build": "tsc -b && vite build",
    "ci": "npm run typecheck && npm test && npm run build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy --keep-vars",
    "deploy:ci": "wrangler deploy --keep-vars",
    "release": "npm run db:migrate:remote && npm run deploy",
    "types": "wrangler types",
    "typecheck": "tsc -b --pretty false",
    "test": "npm run test:unit && npm run test:worker",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "verify:production": "node scripts/verify-production.mjs",
    "db:migrate:local": "wrangler d1 migrations apply kit-hub-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply kit-hub-db --remote"
  },
  "dependencies": {
    "@giphy/js-fetch-api": "^5.8.0",
    "better-auth": "^1.6.26",
    "hono": "^4.13.1",
    "lucide-react": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.1",
    "@cloudflare/vitest-pool-workers": "^0.21.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
