{
  "name": "kit-hub-family-platform",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:ui": "vite --config vite.ui.config.ts --open '/?demo=1'",
    "build": "tsc -b && vite build",
    "ci": "npm run typecheck && npm test && npm run build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "deploy:ci": "wrangler deploy",
    "release": "npm run db:migrate:remote && npm run deploy",
    "types": "wrangler types",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply kit-hub-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply kit-hub-db --remote"
  },
  "dependencies": {
    "better-auth": "^1.6.26",
    "hono": "^4.13.1",
    "lucide-react": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
